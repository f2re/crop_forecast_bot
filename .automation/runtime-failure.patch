+                    "JOIN fields f ON f.id = s.field_id "
+                    "JOIN users u ON u.id = f.user_id "
+                    "WHERE u.telegram_id = 1600"
+                )
+            )
+        assert (user_count, field_count, season_count) == (0, 0, 0)
+    finally:
