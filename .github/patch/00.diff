+++ b/src/bot/errors.py
@@ -0,0 +1,127 @@
+from __future__ import annotations
+
+import logging
+from contextlib import suppress
+from uuid import uuid4
+
+from aiogram import Bot
+from aiogram.exceptions import TelegramBadRequest, TelegramNetworkError
+from aiogram.types import CallbackQuery, ErrorEvent, Update
+from redis.exceptions import RedisError
+from sqlalchemy.exc import SQLAlchemyError
+
+from src.bot.keyboards import get_main_keyboard
+
+logger = logging.getLogger(__name__)
+
+_MESSAGE_NOT_MODIFIED = "message is not modified"
+_EDIT_TARGET_UNAVAILABLE = (
+    "message to edit not found",
+    "message can't be edited",
+    "message identifier is not specified",
+)
+
+
+def _chat_id(update: Update) -> int | None:
+    if update.callback_query is not None:
+        callback = update.callback_query
+        if callback.message is not None:
+            return callback.message.chat.id
+        return callback.from_user.id
+    if update.message is not None:
+        return update.message.chat.id
+    if update.edited_message is not None:
+        return update.edited_message.chat.id
+    return None
+
+
+async def _answer_callback(callback: CallbackQuery | None, text: str) -> None:
+    if callback is None:
+        return
+    with suppress(Exception):
+        await callback.answer(text, show_alert=True)
+
+
+async def _send_recovery_message(bot: Bot, update: Update, text: str) -> None:
+    chat_id = _chat_id(update)
+    if chat_id is None:
+        return
+    with suppress(Exception):
+        await bot.send_message(chat_id, text, reply_markup=get_main_keyboard())
+
+
+def _log_exception(error_id: str, event: ErrorEvent) -> None:
+    exception = event.exception
+    logger.error(
+        "Unhandled Telegram update failure error_id=%s update_id=%s exception=%s",
+        error_id,
+        event.update.update_id,
+        type(exception).__name__,
+        exc_info=(type(exception), exception, exception.__traceback__),
+    )
+
+
+async def handle_runtime_error(event: ErrorEvent, bot: Bot) -> bool:
+    """Convert dependency and stale-message failures into controlled UX.
+
+    The handler is registered on the dispatcher's built-in error observer, so it
+    also sees failures raised by FSM storage before a concrete message/callback
+    handler starts. Every branch logs a correlation identifier without exposing
+    technical details to the Telegram user.
+    """
+
+    exception = event.exception
+    callback = event.update.callback_query
+    error_id = uuid4().hex[:10]
+
+    if isinstance(exception, TelegramBadRequest):
+        message = str(exception).lower()
+        if _MESSAGE_NOT_MODIFIED in message:
+            await _answer_callback(callback, "Данные уже актуальны")
+            return True
+        if any(marker in message for marker in _EDIT_TARGET_UNAVAILABLE):
+            _log_exception(error_id, event)
+            await _answer_callback(callback, "Сообщение устарело; меню открыто заново")
+            await _send_recovery_message(
+                bot,
+                event.update,
+                "ℹ️ Исходное сообщение было удалено или устарело. "
+                "Открываю актуальное меню.",
+            )
+            return True
+
+    if isinstance(exception, SQLAlchemyError):
+        _log_exception(error_id, event)
+        await _answer_callback(callback, "Хранилище временно недоступно")
+        await _send_recovery_message(
+            bot,
+            event.update,
+            "⚠️ Хранилище данных временно недоступно. "
+            f"Повторите действие позже. Код ошибки: <code>{error_id}</code>",
+        )
+        return True
+
+    if isinstance(exception, RedisError):
+        _log_exception(error_id, event)
+        await _answer_callback(callback, "Состояние диалога временно недоступно")
+        await _send_recovery_message(
+            bot,
+            event.update,
+            "⚠️ Не удалось прочитать состояние диалога. "
+            f"Повторите действие позже. Код ошибки: <code>{error_id}</code>",
+        )
+        return True
+
+    if isinstance(exception, TelegramNetworkError):
+        _log_exception(error_id, event)
+        return True
+
+    _log_exception(error_id, event)
+    await _answer_callback(callback, "Внутренняя ошибка")
+    await _send_recovery_message(
+        bot,
+        event.update,
+        "⚠️ Не удалось выполнить действие из-за внутренней ошибки. "
