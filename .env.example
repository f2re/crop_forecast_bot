# Runtime mode: development allows memory FSM fallback; production requires Redis.
APP_ENV=development

# Required: Telegram token from @BotFather.
TELEGRAM_BOT_TOKEN=

# PostgreSQL through the async SQLAlchemy driver.
# The native deploy script creates a local role, database and strong password.
DATABASE_URL=postgresql+asyncpg://cropbot:change-me@127.0.0.1:5432/crop_forecast_bot

# Persistent aiogram FSM, scheduler locks and notification deduplication.
REDIS_URL=redis://127.0.0.1:6379/0
COORDINATION_NAMESPACE=crop-forecast-bot

# Runtime
LOG_LEVEL=INFO
SCHEDULER_TIMEZONE=Europe/Moscow

# Writable paths for a manual development launch.
# Native systemd deployment overrides these with /run and /var/cache paths.
HEARTBEAT_FILE=.runtime/heartbeat
OPEN_METEO_CACHE_PATH=.cache/openmeteo

# Copernicus CDS API: current key format without the legacy UID prefix.
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# Optional LLM-compatible provider. RAG must retain source attribution.
OPENROUTER_API_KEY=
