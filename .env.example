# Required: Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=

# Docker Compose database settings. Use a unique strong password.
DB_NAME=crop_forecast_bot
DB_USER=cropbot
DB_PASSWORD=change-me

# Native/systemd installation may override the complete async URL.
DATABASE_URL=postgresql+asyncpg://cropbot:change-me@127.0.0.1:5432/crop_forecast_bot

# Persistent aiogram FSM. Docker Compose overrides the host to redis.
REDIS_URL=redis://127.0.0.1:6379/0

# Runtime
LOG_LEVEL=INFO
SCHEDULER_TIMEZONE=Europe/Moscow
HEARTBEAT_FILE=/tmp/crop_forecast_bot/heartbeat

# Copernicus CDS API: current key format without the legacy UID prefix.
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# Optional LLM-compatible provider. RAG must retain source attribution.
OPENROUTER_API_KEY=
