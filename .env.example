# Runtime mode. Production requires PostgreSQL and Redis.
APP_ENV=development

# Required: Telegram token from @BotFather.
TELEGRAM_BOT_TOKEN=

# PostgreSQL through the async SQLAlchemy driver.
DATABASE_URL=postgresql+asyncpg://cropbot:change-me@127.0.0.1:5432/crop_forecast_bot

# Persistent aiogram FSM, scheduler leases and notification deduplication.
REDIS_URL=redis://127.0.0.1:6379/0
COORDINATION_NAMESPACE=crop-forecast-bot

# Runtime
LOG_LEVEL=INFO
SCHEDULER_TIMEZONE=Europe/Moscow
HEARTBEAT_FILE=.runtime/heartbeat
OPEN_METEO_CACHE_PATH=.cache/openmeteo
RISK_HISTORY_RETENTION_DAYS=30

# Low-resource MVP defaults. The shared executor is used by synchronous
# Open-Meteo adapters through asyncio.to_thread().
BLOCKING_IO_WORKERS=2
RISK_CHECK_ON_STARTUP=true
RISK_CHECK_STARTUP_DELAY_SECONDS=120

# The multi-decadal ERA5 comparison is optional and disabled in production MVP.
# Operational forecast, season history, GDD/HTC and ensemble risks remain active.
CLIMATE_REFERENCE_ENABLED=false

# Pull-based CD. The server checks main every 15 minutes, but deploys only a new
# commit whose required GitHub Actions CI run completed successfully.
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_REQUIRE_GREEN_CI=true
GITHUB_REPOSITORY=f2re/crop_forecast_bot
GITHUB_API_URL=https://api.github.com
# Optional for a public repository; set a fine-grained read-only token if the
# server must avoid anonymous GitHub API limits.
GITHUB_API_TOKEN=

# Optional RAG profile. Keep disabled on weak servers unless
# requirements-rag.txt is installed and the literature index has been created.
RAG_ENABLED=false
INSTALL_RAG_PROFILE=0
LLM_PROVIDER=groq
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENAI_API_KEY=
